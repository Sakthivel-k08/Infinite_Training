@{
    Layout = null;
    var title = ViewBag.Title ?? "Northwind MVC";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@title</title>
    <style>
        :root {
            --bg: #f7f9fc;
            --card: #ffffff;
            --text: #1a1a1a;
            --muted: #6b7280;
            --accent: #2563eb;
            --border: #e5e7eb;
        }

        body {
            font-family: Segoe UI, Roboto, Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            margin: 0;
        }

        .nav {
            background: var(--card);
            border-bottom: 1px solid var(--border);
            padding: 12px 20px;
            display: flex;
            gap: 16px;
        }

            .nav a {
                color: var(--accent);
                text-decoration: none;
                font-weight: 600;
            }

        .container {
            max-width: 980px;
            margin: 24px auto;
            padding: 0 20px;
        }

        h1 {
            font-size: 22px;
            margin: 12px 0 18px;
        }

        .card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 16px;
            box-shadow: 0 1px 2px rgba(0,0,0,.04);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th, td {
            padding: 10px;
            border-bottom: 1px solid var(--border);
            text-align: left;
        }

        th {
            background: #f3f4f6;
            color: #111827;
        }

        .muted {
            color: var(--muted);
        }

        .badge {
            display: inline-block;
            padding: 2px 8px;
            border-radius: 999px;
            background: #eef2ff;
            color: var(--accent);
            font-size: 12px;
        }

        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .kv {
            display: grid;
            grid-template-columns: 160px 1fr;
            gap: 8px;
            margin-top: 6px;
        }

            .kv .key {
                color: var(--muted);
            }

        .foot {
            margin-top: 16px;
            font-size: 12px;
            color: var(--muted);
        }
    </style>
</head>
<body>
    <div class="nav">
        <a href="@Url.Action("GermanCustomers", "Code")">German Customers</a>
        <a href="@Url.Action("OrderDetails", "Code", new { id = 10248 })">Order 10248</a>
    </div>
    <div class="container">
        @RenderBody()
        <div class="foot">Northwind MVC • @DateTime.Now.ToShortDateString()</div>
    </div>
</body>
</html>
